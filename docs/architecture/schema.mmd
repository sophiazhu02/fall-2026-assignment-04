erDiagram
    USERS {
        int id PK
        string email
        string name
        timestamp created_at
    }

    GENRES {
        int id PK
        string name
    }

    BOOKS {
        int id PK
        int genre_id FK
        string title
        string isbn
    }

    AUTHORS {
        int id PK
        string first_name
        string last_name
    }

    BOOK_AUTHORS {
        int id PK
        int book_id FK
        int author_id FK
    }

    BORROWERS {
        int id PK
        int user_id FK
    }

    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        date checkout_date
        date due_date
        date returned_date
    }

    GENRES ||--o{ BOOKS : contains
    BOOKS ||--o{ BOOK_AUTHORS : has
    AUTHORS ||--o{ BOOK_AUTHORS : writes
    USERS ||--o| BORROWERS : has
    BORROWERS ||--o{ LOANS : has
    BOOKS ||--o{ LOANS : has